# ── Backend (Express / Railway) ──────────────────────────────────────────────

# Puerto del servidor (Railway lo sobreescribe automáticamente con su propio PORT)
PORT=3001

# Secreto para firmar JWT — CAMBIAR en producción, usar una cadena aleatoria larga
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-seguro-aleatorio

# Orígenes permitidos por CORS (separados por coma si hay más de uno)
# En producción: URL de Vercel. En dev: http://localhost:5173
CORS_ORIGIN=https://matilde-empanadas.vercel.app

# Hash bcrypt de la contraseña del admin
# Si no se setea, usa la contraseña por defecto (matilde2025) al primer arranque
# Para cambiarla: entrá al panel admin → tab Contraseña, luego copiá el nuevo hash
# de server/data/auth.json y pegalo acá para que persista entre redeploys de Railway
# Generá un hash con: node -e "require('bcryptjs').hash('tu-clave', 10).then(console.log)"
ADMIN_PASSWORD_HASH=
